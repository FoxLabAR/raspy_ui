---
import "../styles/global.scss";
import GlobalTerminal from "../components/GlobalTerminal.vue";

import ConnectionStatus from "../components/ConnectionStatus.vue";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Raspi Management UI" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/raspberry-pi-logo.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title} | RASPI_UI</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=JetBrains+Mono:wght@400;700&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css"
            rel="stylesheet"
        />
    </head>
    <body>
        <div class="app-layout">
            <aside class="sidebar">
                <div class="brand">
                    <img
                        src="/raspberry-pi-logo.svg"
                        alt="RPI Logo"
                        class="logo-img"
                    />
                    RASPI<span class="highlight">.CMD</span>
                </div>
                <nav class="main-nav">
                    <a href="/" class="nav-item">
                        <i class="ri-dashboard-line icon"></i> DASHBOARD
                    </a>
                    <a href="/repos" class="nav-item">
                        <i class="ri-git-repository-line icon"></i> REPOSITORIES
                    </a>
                    <a href="/files" class="nav-item">
                        <i class="ri-folder-2-line icon"></i> FILES
                    </a>
                    <a href="/services" class="nav-item">
                        <i class="ri-server-line icon"></i> SERVICES
                    </a>
                    <a href="/settings" class="nav-item bottom">
                        <i class="ri-settings-4-line icon"></i> SETTINGS
                    </a>
                </nav>
            </aside>
            <main class="main-content">
                <header class="top-bar">
                    <h1 class="page-title">{title}</h1>
                    <ConnectionStatus client:load />
                </header>
                <div class="content-scroll">
                    <slot />
                </div>
            </main>
        </div>

        <GlobalTerminal client:load />
    </body>
</html>

<style lang="scss">
    .app-layout {
        display: flex;
        height: 100vh;
        width: 100vw;
        overflow: hidden;
    }

    .sidebar {
        width: 240px;
        background: var(--bg-panel);
        border-right: 1px solid var(--border-light);
        display: flex;
        flex-direction: column;
        z-index: 10;
        padding-bottom: 50px; /* Space for footer terminal */

        .brand {
            height: 60px;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            font-family: "JetBrains Mono", monospace;
            font-weight: 700;
            letter-spacing: -0.5px;
            color: var(--text-main);

            .logo-img {
                height: 32px;
                width: auto;
                margin-right: 0.75rem;
                filter: drop-shadow(0 0 5px rgba(220, 20, 60, 0.5));
            }

            .highlight {
                color: var(--accent-pink);
            }
        }

        .main-nav {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 1rem 0;

            .nav-item {
                display: flex;
                align-items: center;
                padding: 0.75rem 1.5rem;
                color: var(--text-muted);
                font-size: 0.9rem;
                font-weight: 500;
                transition: all 0.2s;
                border-left: 3px solid transparent;

                .icon {
                    margin-right: 0.75rem;
                    font-size: 1.1rem;
                }

                &:hover,
                &.active {
                    background: rgba(255, 255, 255, 0.03);
                    color: var(--text-main);
                }

                &.active {
                    border-left-color: var(--accent-cyan);
                }

                &.bottom {
                    margin-top: auto;
                }
            }

            .spacer {
                flex: 1;
            }
        }
    }

    .main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: var(--bg-app);
        position: relative;

        .top-bar {
            height: 60px;
            border-bottom: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;

            .page-title {
                font-size: 1.2rem;
                font-weight: 600;
                margin: 0;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .connection-status {
                font-size: 0.75rem;
                font-family: "JetBrains Mono";
                padding: 0.25rem 0.5rem;
                border-radius: 2px;
                background: rgba(0, 255, 100, 0.1);
                color: var(--accent-green);
                border: 1px solid var(--accent-green);

                &.offline {
                    background: rgba(255, 50, 50, 0.1);
                    color: var(--accent-danger);
                    border-color: var(--accent-danger);
                }
            }
        }

        .content-scroll {
            flex: 1;
            overflow-y: auto;
            padding: 2rem;
            padding-bottom: 60px; /* Space for terminal footer */
        }
    }
</style>
